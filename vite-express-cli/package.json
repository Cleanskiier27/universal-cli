{
  "name": "vite-express-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Vite, Express, and Node.js CLI starter application.",
  "bin": {
    "vex": "./bin/vex.js"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "vite": "^7.2.7"
  }
}
