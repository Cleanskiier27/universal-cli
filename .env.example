# Copy this file to .env and fill in the values. Do NOT commit your real secrets.

# AI Provider API Keys (set at least one)
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Azure Foundry (OpenAI-compatible deployments)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
AZURE_FOUNDRY_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
# Auth mode: api-key or bearer
AZURE_FOUNDRY_AUTH_MODE=api-key
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_KEY=
# Alternative Gemini key name used by the local Gemini launcher.
GEMINI_API_KEY=
# Required bearer token for LAN access to http://192.168.68.54:3000/gemini.
GEMINI_LAUNCHER_TOKEN=
CUSTOM_AI_ENDPOINT=http://localhost:11434/v1
CUSTOM_AI_KEY=

# AI Gateway Configuration
AI_GATEWAY_PORT=3002
AI_DEFAULT_PROVIDER=openai
AI_RATE_LIMIT_PER_MINUTE=60
AI_CACHE_TTL_SECONDS=300
AI_ALLOW_ANONYMOUS=true
AI_ALLOW_UNREGISTERED=true
AI_API_KEY=your-api-key-for-testing
ADMIN_KEY=your-admin-key

# Security Monitor (security-monitor.js)
SECURITY_PORT=3006
# Required to call admin endpoints (unblock IP, clear alerts). If unset,
# those endpoints are disabled rather than left unauthenticated.
SECURITY_ADMIN_TOKEN=
